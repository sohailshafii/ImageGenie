.claude/settings.local.json

# macOS
.DS_Store

# Python
# Local secrets sourced by the deploy scripts (admin creds + TF_VAR_resend_api_key).
# Commit .env.example instead.
.env

__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Objaverse cache + derived data (NOT redistributed — see NFR-6 / distribution policy)
.objaverse/
data/
*.csv
!requirements*.txt

# Local render captures from capture_renders.py (analysis output, not source)
render_captures/

# Alembic bytecode (versions/ itself is tracked — migrations are source)
server/alembic/versions/__pycache__/

# Editor swap/backup files for the secrets file
.env.*
!.env.example

# Full-resolution source art. The tracked cover is the derived JPG under
# docs/images/ — ~200 KB against ~2 MB, and every visitor to the repo page pays
# for whatever the README embeds.
source_images/

# Screen-recorded demos — tens of MB each (33 MB raw, 9 MB cropped). They reach
# the README as GitHub attachment URLs, which live on GitHub's CDN rather than in
# the tree, so a clone never pays for them. Committing one is effectively
# permanent: history can't be pruned without a rewrite.
*.mov
*.mp4
