# Build context is the repo root (server/Dockerfile builds both the API image and
# the SPA). Keep the context small: exclude everything the build doesn't need.
#
# .gcloudignore includes this file, so these exclusions also govern what
# `gcloud builds submit` uploads — which is why the secrets below matter here and
# not only in .gitignore.

# Secrets. `.env` holds the Resend API key, the admin bootstrap password and the
# TF_VAR_* values; it is gitignored, but .gitignore has no bearing on a build
# context or on a Cloud Build upload. Nothing in any image reads it — config
# arrives as env vars (local) or from Secret Manager (cloud).
.env
.env.*

# Git + OS cruft
.git
.gitignore
**/.DS_Store

# Python: virtualenv, caches, compiled files
.venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/*.egg-info

# Node: dependencies are installed fresh via `npm ci` in the build stage, and the
# SPA is compiled in-image — never ship the host's copies.
**/node_modules
web/dist

# Data, local pipeline outputs, and the Objaverse cache are never part of an image
data
render_captures
.objaverse

# Terraform state and downloaded providers (131 MB) — infra, not runtime
infra/.terraform
**/*.tfstate*

# Local tooling / editor / scratch
.claude
scratchpad
